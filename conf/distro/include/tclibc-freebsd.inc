LIBCOVERRIDE = ":libc-freebsd"
TARGET_OS = "${FREEBSD_TARGET_OS}"
MODIFYTOS = "0"
BASECANADIANEXTRAOS = ""
BASE_LIB = "lib"
BASE_LIB:tune-x86-64 = "lib"
BASE_LIB:tune-x86-64-v3 = "lib"
BASE_LIB:tune-cortexa57 = "lib"
PREFERRED_PROVIDER_virtual/libc = "freebsd-base"
PREFERRED_PROVIDER_virtual/libiconv = "freebsd-base"
PREFERRED_PROVIDER_virtual/crypt = "freebsd-base"
# FreeBSD world supplies compiler-rt, libc++ and its libgcc compatibility ABI.
PREFERRED_PROVIDER_virtual/${MLPREFIX}compilerlibs:libc-freebsd = "freebsd-base"
PREFERRED_PROVIDER_compiler-rt = "freebsd-base"
PREFERRED_PROVIDER_libcxx = "freebsd-base"
PREFERRED_PROVIDER_openssl = "freebsd-base"
PREFERRED_PROVIDER_zlib = "freebsd-base"
PREFERRED_PROVIDER_ncurses = "freebsd-base"
PREFERRED_PROVIDER_bzip2 = "freebsd-base"
PREFERRED_PROVIDER_xz = "freebsd-base"
PREFERRED_RPROVIDER_base-files = "freebsd-base-files"
PKG_CONFIG_PATH:append:class-target = ":${STAGING_DIR_HOST}${prefix}/libdata/pkgconfig"
SYSROOT_DIRS:append:class-target = " ${prefix}/libdata"
FILES:${PN}-dev:append:class-target = " ${prefix}/libdata/pkgconfig"
# llvm-ar dispatches by argv[0]; a dotted target version is mistaken for a suffix.
AR:class-target = "llvm-ar"
RANLIB:class-target = "llvm-ranlib"
READELF:class-target = "llvm-readelf"
LIBC_DEPENDENCIES = "freebsd-base"
IMAGE_LINGUAS = ""
