From: Alejandro Hernandez <alejandro@enedino.org>
Subject: [PATCH] config.mak.uname: avoid host FreeBSD prefixes when cross compiling

The compiler sysroot supplies dependencies when cross compiling. Do not
search the build host's local directories.

Upstream-Status: Pending

--- a/config.mak.uname
+++ b/config.mak.uname
@@ -318,8 +318,10 @@ ifeq ($(uname_S),FreeBSD)
         ifeq ($(shell v=$(uname_R) && test $${v%%.*} -lt 12 && echo 1),1)
 		NO_MEMMEM = UnfortunatelyYes
         endif
+ifndef CROSS_COMPILE
 	BASIC_CFLAGS += -I/usr/local/include
 	BASIC_LDFLAGS += -L/usr/local/lib
+endif
 	DIR_HAS_BSD_GROUP_SEMANTICS = YesPlease
 	USE_ST_TIMESPEC = YesPlease
 	PYTHON_PATH = /usr/local/bin/python
