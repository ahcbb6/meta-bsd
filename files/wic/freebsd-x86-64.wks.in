part --source rawcopy --sourceparams="file=${STAGING_LIBDIR}/freebsd-boot/gptboot" --ondisk sda --part-type 83bd6b9d-7f41-11dc-be0b-001560b84f0f --align 64 --fixed-size 512K
part / --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.ffs" --ondisk sda --part-type 516e7cb6-6ecf-11d6-8ff8-00022d09712b --align 1024
bootloader --ptable gpt
